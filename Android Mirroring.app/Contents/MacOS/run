#!/bin/bash
# GUI apps don't inherit the shell PATH
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
log=$(mktemp)
scrcpy --window-title "Android Mirroring" --turn-screen-off --stay-awake \
  --keyboard=uhid --shortcut-mod=lsuper,rsuper 2>"$log" >/dev/null &
pid=$!
"$(dirname "$0")/hangul" $pid & helper=$!
wait $pid || osascript -e 'on run a' -e 'display alert "Android Mirroring" message (item 1 of a)' -e 'end run' \
    "휴대폰 연결 실패. USB 디버깅/무선 디버깅을 켜고 'adb devices'를 확인하세요.

$(tail -n 3 "$log")"
kill $helper; rm -f "$log"
